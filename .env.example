# ===========================================
# BuybackVault Deployment Configuration
# ===========================================

# Required: Private key for deployment (add 0x prefix)
DEPLOYER_KEY=

# Required: Owner address (governance multisig or EOA)
OWNER=

# Required: Treasury address to receive buyback proceeds
TREASURY=

# ===========================================
# Optional Configuration (with defaults)
# ===========================================

# Burn percentage in basis points (default: 7000 = 70%)
# BURN_BPS=7000

# Executor reward in basis points (default: 100 = 1%)
# EXECUTOR_REWARD_BPS=100

# TWAP window in seconds (default: 1800 = 30 minutes, minimum: 1800)
# TWAP_WINDOW=1800

# Max slippage in basis points (default: 200 = 2%, maximum: 500)
# MAX_SLIPPAGE_BPS=200

# Epoch duration in seconds (default: 86400 = 1 day)
# EPOCH_DURATION=86400

